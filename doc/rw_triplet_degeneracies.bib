  doi          = {10.1007/978-3-540-85221-6_5},
  eprint       = {0805.0083},
  archivePrefix= {arXiv},
  primaryClass = {math.CO},
  url          = {https://doi.org/10.1007/978-3-540-85221-6_5},
  abstract     = {Extends the random walks of Bidigare, Hanlon, and Rockmore and of Brown and Diaconis from real
    hyperplane arrangements (which include the Tsetlin library) to complex hyperplane arrangements via associated
    cell complexes, leading to self-organizing libraries with several shelves, and shows that interval greedoids
    give rise to random walks of the same family; all these walks have real nonnegative eigenvalues given by simple
    combinatorial formulas.}
}

@article{LyonsPeresSchramm2006,
  author       = {Lyons, Russell and Peres, Yuval and Schramm, Oded},
  title        = {Minimal spanning forests},
  journal      = {The Annals of Probability},
  volume       = {34},
  number       = {5},
  pages        = {1665--1692},
  year         = {2006},
  doi          = {10.1214/009117906000000269},
  eprint       = {math/0412263},
  archivePrefix= {arXiv},
  url          = {https://doi.org/10.1214/009117906000000269},
  abstract     = {Studies the free and wired minimal spanning forests of infinite graphs, defined from
    i.i.d.\ uniform edge labels by deleting every edge whose label is maximal on some cycle (respectively, cycle or
    bi-infinite path); relates the wired forest to invasion percolation and establishes properties of both forests
    and their connections with Bernoulli percolation.}
}

@article{HeldKarp1962,
  author       = {Held, Michael and Karp, Richard M.},
  title        = {A dynamic programming approach to sequencing problems},
  journal      = {Journal of the Society for Industrial and Applied Mathematics},
  volume       = {10},
  number       = {1},
  pages        = {196--210},
  year         = {1962},
  doi          = {10.1137/0110015},
  url          = {https://doi.org/10.1137/0110015},
  abstract     = {Formulates sequencing problems, including the traveling salesman problem, as dynamic programs over
    subsets of jobs or cities (the Held--Karp recursion), solving an $n$-city instance in $O(n^2 2^n)$ time, and
    discusses approximate methods for larger instances.}
}

@inproceedings{BjorklundHusfeldtKaskiKoivisto2007,
  author       = {Bj{\"o}rklund, Andreas and Husfeldt, Thore and Kaski, Petteri and Koivisto, Mikko},
  title        = {Fourier meets {M\"o}bius: fast subset convolution},
  booktitle    = {Proceedings of the 39th Annual ACM Symposium on Theory of Computing (STOC '07)},
  pages        = {67--74},
  publisher    = {ACM},
  year         = {2007},
  doi          = {10.1145/1250790.1250801},
  eprint       = {cs/0611101},
  archivePrefix= {arXiv},
  url          = {https://doi.org/10.1145/1250790.1250801},
  abstract     = {Computes the subset convolution of two functions on the subsets of an $n$-element set in
    $O(n^2 2^n)$ ring operations using fast zeta and M{\"o}bius transforms over the subset lattice, with
    applications to exact algorithms for Steiner tree, graph coloring, and covering and partitioning problems.}
}

@article{Renyi1953,
  author       = {R{\'e}nyi, Alfr{\'e}d},
  title        = {On the theory of order statistics},
  journal      = {Acta Mathematica Academiae Scientiarum Hungaricae},
  volume       = {4},
  number       = {3--4},
  pages        = {191--231},
  year         = {1953},
  doi          = {10.1007/BF02127580},
  url          = {https://doi.org/10.1007/BF02127580},
  abstract     = {Introduces the representation of the order statistics of an i.i.d.\ exponential sample as partial
    sums of independent exponential spacings with rates $n, n-1, \dots, 1$ (R{\'e}nyi's representation), and uses it
    to reduce limit problems for order statistics to sums of independent random variables.}
}

@article{Harris1960,
  author       = {Harris, T. E.},
  title        = {A lower bound for the critical probability in a certain percolation process},
  journal      = {Mathematical Proceedings of the Cambridge Philosophical Society},
  volume       = {56},
  number       = {1},
  pages        = {13--20},
  year         = {1960},
  doi          = {10.1017/S0305004100034241},
  url          = {https://doi.org/10.1017/S0305004100034241},
  abstract     = {Proves that the critical probability of bond percolation on the square lattice is at least $1/2$;
    the proof introduces the inequality that increasing events are positively correlated under product measure
    (Harris's lemma).}
}

@article{EsaryProschanWalkup1967,
  author       = {Esary, J. D. and Proschan, F. and Walkup, D. W.},
  title        = {Association of random variables, with applications},
  journal      = {The Annals of Mathematical Statistics},
  volume       = {38},
  number       = {5},
  pages        = {1466--1474},
  year         = {1967},
  doi          = {10.1214/aoms/1177698701},
  url          = {https://doi.org/10.1214/aoms/1177698701},
  abstract     = {Defines association of random variables ($\mathrm{Cov}[f(T), g(T)] \ge 0$ for all nondecreasing
    $f$ and $g$), proves that independent random variables are associated and that association is preserved under
    nondecreasing functions, unions of independent sets, and limits, and applies the concept to bounds in
    reliability theory.}
}

@article{FortuinKasteleynGinibre1971,
  author       = {Fortuin, C. M. and Kasteleyn, P. W. and Ginibre, J.},
  title        = {Correlation inequalities on some partially ordered sets},
  journal      = {Communications in Mathematical Physics},
  volume       = {22},
  number       = {2},
  pages        = {89--103},
  year         = {1971},
  doi          = {10.1007/BF01651330},
  url          = {https://doi.org/10.1007/BF01651330},
  abstract     = {Proves the FKG inequality: for a log-supermodular probability measure on a finite distributive
    lattice, increasing functions are positively correlated; applications include Ising ferromagnets and related
    lattice models.}
}

@techreport{Dantzig1953RM1266,
  author       = {Dantzig, George B.},
  title        = {Notes on Linear Programming---Part {III}: Computational Algorithm of the Revised Simplex Method},
  institution  = {The RAND Corporation},
  type         = {Research Memorandum},
  number       = {RM-1266},
  address      = {Santa Monica, CA},
  year         = {1953},
  url          = {https://www.rand.org/pubs/research_memoranda/RM1266.html},
  abstract     = {Describes the revised simplex method, in which the inverse of the current basis is maintained and
    only the quantities needed at each iteration (pricing vector and entering column) are computed from the original
    data, instead of updating the full simplex tableau.}
}

@article{DantzigOrchardHays1954,
  author       = {Dantzig, George B. and Orchard-Hays, William},
  title        = {The product form for the inverse in the simplex method},
  journal      = {Mathematical Tables and Other Aids to Computation},
  volume       = {8},
  number       = {46},
  pages        = {64--67},
  year         = {1954},
  doi          = {10.1090/S0025-5718-1954-0061469-8},
  url          = {https://doi.org/10.1090/S0025-5718-1954-0061469-8},
  abstract     = {Represents the inverse of the simplex basis as a product of elementary (eta) matrices, each
    differing from the identity in a single column and appended once per pivot, reducing storage and computation in
    the revised simplex method.}
}

@article{HuangfuHall2018,
  author       = {Huangfu, Qi and Hall, J. A. Julian},
  title        = {Parallelizing the dual revised simplex method},
  journal      = {Mathematical Programming Computation},
  volume       = {10},
  number       = {1},
  pages        = {119--142},
  year         = {2018},
  doi          = {10.1007/s12532-017-0130-5},
  url          = {https://doi.org/10.1007/s12532-017-0130-5},
  abstract     = {This paper introduces the design and implementation of two parallel dual simplex solvers for
    general large scale sparse linear programming problems. One approach, called PAMI, extends a relatively unknown
    pivoting strategy called suboptimization and exploits parallelism across multiple iterations. The other, called
    SIP, exploits purely single iteration parallelism by overlapping computational components when possible.
    Computational results show that the performance of PAMI is superior to that of the leading open-source simplex
    solver, and that SIP complements PAMI in achieving speedup when PAMI results in slowdown.}
}

@article{Arlazarov1970,
  author       = {Arlazarov, V. L. and Dinic, E. A. and Kronrod, M. A. and Faradzev, I. A.},
  title        = {On economical construction of the transitive closure of an oriented graph},
  journal      = {Doklady Akademii Nauk SSSR},
  volume       = {194},
  number       = {3},
  pages        = {487--488},
  year         = {1970},
  note         = {English translation in \emph{Soviet Mathematics Doklady} \textbf{11}, 1209--1210 (1970)},
  url          = {https://www.mathnet.ru/eng/dan35675},
  abstract     = {Introduces the sub-cubic bit-parallel block lookup technique (the Method of the Four Russians)
    that packs Boolean rows into machine words and precomputes all $2^k$ row combinations on stripes of width $k$,
    reducing Boolean matrix multiplication and transitive closure from $O(n^3)$ to $O(n^3 / \log n)$ operations.}
}

@online{Bard2006,
  author       = {Bard, Gregory V.},
  title        = {Accelerating cryptanalysis with the {Method of Four Russians}},
  year         = {2006},
  note         = {Cryptology ePrint Archive, Paper 2006/251},
  url          = {https://eprint.iacr.org/2006/251},
  abstract     = {Adapts the Method of Four Russians from Boolean matrix multiplication to dense matrix inversion
    and row echelonization over $\mathrm{GF}(2)$ (the M4RI algorithm), precomputing Gray-code lookup tables of $2^k$
    linear combinations of $k$ pivot rows to eliminate $k$ columns per pass over memory.}
}

@article{AlbrechtBardHart2010,
  author       = {Albrecht, Martin R. and Bard, Gregory V. and Hart, William},
  title        = {Algorithm 898: Efficient multiplication of dense matrices over {GF(2)}},
  journal      = {ACM Transactions on Mathematical Software},
  volume       = {37},
  number       = {1},
  pages        = {9:1--9:14},
  year         = {2010},
  doi          = {10.1145/1644001.1644010},
  eprint       = {0811.1714},
  archivePrefix= {arXiv},
  primaryClass = {cs.MS},
  url          = {https://doi.org/10.1145/1644001.1644010},
  abstract     = {We describe an efficient implementation of a hierarchy of algorithms for multiplication of dense
    matrices over the field with two elements ($\mathrm{GF}(2)$). In particular we present our implementation---in
    the M4RI library---of Strassen-Winograd matrix multiplication and the Method of the Four Russians multiplication
    (M4RM) and compare it against other available implementations.}
}

@techreport{Zobrist1970,
  author       = {Zobrist, Albert L.},
  title        = {A new hashing method with application for game playing},
  institution  = {Computer Sciences Department, University of Wisconsin, Madison},
  number       = {88},
  year         = {1970},
  note         = {Reprinted in \emph{ICCA Journal} \textbf{13}(2), 69--73 (1990)},
  doi          = {10.3233/ICG-1990-13203},
  url          = {https://doi.org/10.3233/ICG-1990-13203},
  abstract     = {Introduces Zobrist hashing, mapping subsets or configurations of discrete features to fixed-width
    bit-strings by XORing independent random bit-masks assigned to each elementary feature, allowing incremental
    $O(1)$ hash updates under symmetric-difference transitions.}
}

@article{CarterWegman1979,
  author       = {Carter, J. Lawrence and Wegman, Mark N.},
  title        = {Universal classes of hash functions},
  journal      = {Journal of Computer and System Sciences},
  volume       = {18},
  number       = {2},
  pages        = {143--154},
  year         = {1979},
  doi          = {10.1016/0022-0000(79)90044-8},
  url          = {https://doi.org/10.1016/0022-0000(79)90044-8},
  abstract     = {This paper gives an input independent average linear time algorithm for storage and retrieval on
    keys. The algorithm makes a random choice of hash function from a suitable class of hash functions. Given any
    sequence of inputs the expected time (averaging over all functions in the class) to store and retrieve elements
    is linear in the length of the sequence. We present three suitable classes of hash functions which also can be
    evaluated rapidly.}
}

@article{Good1953,
  author       = {Good, I. J.},
  title        = {The population frequencies of species and the estimation of population parameters},
  journal      = {Biometrika},
  volume       = {40},
  number       = {3/4},
  pages        = {237--264},
  year         = {1953},
  doi          = {10.2307/2333344},
  url          = {https://doi.org/10.2307/2333344},
  abstract     = {A random sample is drawn from a population of animals of various species. (The theory may also be
    applied to studies of literary vocabulary, for example.) If a particular species is represented $r$ times in the
    sample of size $N$, then $r/N$ is not a good estimate of the population frequency, $p$, when $r$ is small.
    Methods are given for estimating $p$, assuming virtually nothing about the underlying population. The estimates
    are expressed in terms of smoothed values of the numbers $n_r$ ($r = 1, 2, 3, \dots$), where $n_r$ is the number
    of distinct species that are each represented $r$ times in the sample. ($n_r$ may be described as `the frequency
    of the frequency $r$'.) Turing is acknowledged for the most interesting formula in this part of the work.}
}

@article{Chao1984,
  author       = {Chao, Anne},
  title        = {Nonparametric estimation of the number of classes in a population},
  journal      = {Scandinavian Journal of Statistics},
  volume       = {11},
  number       = {4},
  pages        = {265--270},
  year         = {1984},
  url          = {https://www.jstor.org/stable/4615964},
  abstract     = {Assume that a random sample is drawn from a population with an unknown number of classes. This
    work proposes a nonparametric method to estimate the number of classes when most of the information is
    concentrated on the low order occupancy numbers. The percentile method (Efron, 1981, 1982) is applied to
    construct confidence intervals based on bootstrap distributions. Using real data sets, we also compare the
    proposed point and interval estimates with previously published results.}
}

@article{Chao1987,
  author       = {Chao, Anne},
  title        = {Estimating the population size for capture-recapture data with unequal catchability},
  journal      = {Biometrics},
  volume       = {43},
  number       = {4},
  pages        = {783--791},
  year         = {1987},
  doi          = {10.2307/2531532},
  url          = {https://doi.org/10.2307/2531532},
  abstract     = {A point estimator and its associated confidence interval for the size of a closed population are
    proposed under models that incorporate heterogeneity of capture probability. Real data sets provided in Edwards
    and Eberhardt (1967, Journal of Wildlife Management 31, 87--96) and Carothers (1973, Journal of Animal Ecology
    42, 125--146) are used to illustrate this method and to compare it with other estimates. The performance of the
    proposed procedure is also investigated by means of Monte Carlo experiments. The method is especially useful when
    most of the captured individuals are caught once or twice in the sample, for which case the jackknife estimator
    usually does not work well. Numerical results also show that the proposed confidence interval performs
    satisfactorily in maintaining the nominal levels.}
}

@article{ChiuWangWaltherChao2014,
  author       = {Chiu, Chun-Huo and Wang, Yi-Ting and Walther, Bruno A. and Chao, Anne},
  title        = {An improved nonparametric lower bound of species richness via a modified {Good--Turing} frequency
    formula},
  journal      = {Biometrics},
  volume       = {70},
  number       = {3},
  pages        = {671--682},
  year         = {2014},
  doi          = {10.1111/biom.12200},
  url          = {https://doi.org/10.1111/biom.12200},
  abstract     = {Reviews the classic abundance-based Chao1 and incidence-based Chao2 nonparametric lower-bound
    estimators together with their bias-corrected forms for finite samples, and derives improved nonparametric lower
    bounds for both individual-based abundance data and replicated incidence data by combining a modified
    Good--Turing frequency formula with singleton through quadrupleton counts.}
}
